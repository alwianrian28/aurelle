# Copy to .env and set real values. .env is never committed.
# Used by docker-compose.yml (and by the backend tests when run from your machine).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
# Optional: OAuth client ID that switches on "Continue with Google" (not a secret).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application,
# with http://localhost:5173 under "Authorized JavaScript origins". Leave empty to keep it off.
GOOGLE_CLIENT_ID=
# Midtrans (Dashboard > Settings > Access Keys). Sandbox keys start with "SB-".
# The server key is a secret and stays on the backend; the client key is public.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set to true only with production keys.
MIDTRANS_IS_PRODUCTION=false
# Where Midtrans reports payment status. Defaults to the deployed site.
MIDTRANS_NOTIFICATION_URL=https://byaurelle.vercel.app/api/payments/midtrans/notification
# Cards are paid in the shop's own card form. Set to "midtrans" to show Midtrans' form instead.
MIDTRANS_CARD_FORM=own
# The QRIS code is drawn by the shop itself. Set to "midtrans" to show Midtrans' form instead.
MIDTRANS_QRIS_FORM=own

# --- Shipment map (all optional; the values shown are the defaults) ---
# Where the store is on the map. Empty: the middle of the district or city of the store's postal code.
BITESHIP_ORIGIN_LAT=
BITESHIP_ORIGIN_LNG=
# Seconds Biteship's answer about a shipment is reused before Biteship is asked again. 0 asks every time.
BITESHIP_TRACKING_CACHE_SECONDS=60
# Part of the route (percent) the parcel is drawn on at each stage, and how long two of the stages are taken to last.
TRACKING_PROGRESS_PICKED=0-5
TRACKING_PROGRESS_TRANSIT=5-85
TRACKING_PROGRESS_DROPOFF=85-98
TRACKING_PICKED_HOURS=6
TRACKING_DROPOFF_HOURS=8
# Geocoder (district or city name -> point) and router. An empty value switches one off.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# Sent to both as the application's contact (OpenStreetMap's usage policy): an email address or a URL.
MAP_CONTACT=https://byaurelle.vercel.app
# Days before an area the geocoder did not know is looked up again.
GEO_RETRY_DAYS=7
