# Copy to .env and set real values. .env is never committed.
# Used by docker-compose.yml (and by the backend tests when run from your machine).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
# Optional: OAuth client ID that switches on "Continue with Google" (not a secret).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application,
# with http://localhost:5173 under "Authorized JavaScript origins". Leave empty to keep it off.
GOOGLE_CLIENT_ID=
# Midtrans (Dashboard > Settings > Access Keys). Sandbox keys start with "SB-".
# The server key is a secret and stays on the backend; the client key is public.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set to true only with production keys.
MIDTRANS_IS_PRODUCTION=false
# Where Midtrans reports payment status. Defaults to the deployed site.
MIDTRANS_NOTIFICATION_URL=https://byaurelle.vercel.app/api/payments/midtrans/notification
# Own card form on the payment page (Core API) instead of Midtrans' form. Turn on only after
# Midtrans has enabled the Core API for the account: until then a charge answers "Access denied".
MIDTRANS_CORE_API=false
