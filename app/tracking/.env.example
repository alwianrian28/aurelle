# Salin ke .env (tidak pernah di-commit). Semua nilai di sini hanya dibaca server.

# Biteship > Integrations > API key. Key berawalan biteship_test. = mode sandbox.
BITESHIP_API_KEY=biteship_test.xxxxx
# Webhook: "signature key" di dashboard Biteship = nama header, "signature secret" = nilainya.
BITESHIP_WEBHOOK_HEADER=X-Webhook-Secret
BITESHIP_WEBHOOK_SECRET=

# Supabase > Connect. Password berkarakter khusus harus di-URL-encode (@ -> %40, dst).
# Runtime: Transaction pooler (port 6543).
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Alembic: Session pooler (port 5432) atau direct connection.
DATABASE_URL_MIGRATION=postgresql+asyncpg://postgres.<project_ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# "require" untuk Supabase. "disable" hanya untuk PostgreSQL lokal (testing).
DATABASE_SSL=require

# Supabase Storage (foto bukti). service_role key melewati RLS: jangan pernah dikirim ke browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=shipment-photos

# Token untuk POST /api/shipments/{no_resi}/histories (header X-Admin-Token).
# Kosong = endpoint input manual dimatikan.
ADMIN_API_TOKEN=

APP_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Jakarta
